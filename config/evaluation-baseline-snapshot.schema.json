  "properties": {
    "snapshot_schema_version": {
      "const": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_schema_version",
        "baseline_id",
        "suite",
        "protocol",
        "promoted_at",
        "promoted_by_mode",
        "source_run_id",
        "source_invocation_id",
        "manifest_digest",
        "results_digest",
        "git_commit",
        "source_fingerprint",
        "source_integrity",
        "lineage_status",
        "lineage_limitations",
        "scenario_set_fingerprint",
        "selected_datasets",
        "business_fixture_fingerprint",
