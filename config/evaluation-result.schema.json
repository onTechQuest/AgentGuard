            "router_allowance_ms": {
              "type": "number",
              "minimum": 0
            },
            "recovery_reserve_ms": {
              "type": "number",
              "minimum": 0
            },
            "synthesis_allowance_ms": {
              "type": "number",
              "minimum": 0
            },
            "recovery_synthesis_reserve_ms": {
              "type": "number",
              "minimum": 0
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,96}$"
            },
            "retries_enabled": {
              "const": false
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "observation_contract_version"
        ]
      },
      "then": {
        "required": [
          "observation_contract_version",
          "observations",
          "continuous_aggregates",
          "metric_registry_version",
          "source_integrity",
          "protocol"
        ]
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "oneOf": [
        {
          "const": "UNKNOWN"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "resolved",
        "provider",
        "resolution_provenance"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "schema_version",
        "count",
        "fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
