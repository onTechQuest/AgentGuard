{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentguard:evaluation-run-manifest:1",
  "title": "EvaluationRunManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "canonicalization_version", "run_id", "timestamp", "suite", "execution_mode", "source", "production_models", "judge_models", "datasets", "scenario_count", "planned_execution_count", "scenario_set_fingerprint", "execution_order_fingerprint", "fingerprints", "libraries", "hosting", "lineage_status", "unavailable_fields"],
  "properties": {
    "manifest_schema_version": {"const": 1},
    "canonicalization_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "suite": {"enum": ["smoke", "full", "performance", "reliability", "structural"]},
    "execution_mode": {"enum": ["live", "offline_fixture", "replay"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["git_commit", "dirty_state", "source_fingerprint"],
      "properties": {
        "git_commit": {"type": "string"},
        "dirty_state": {"enum": ["CLEAN", "DIRTY", "UNKNOWN"]},
        "source_fingerprint": {"$ref": "#/$defs/identity"}
      }
    },
    "production_models": {"oneOf": [{"const": "UNKNOWN"}, {"type": "object", "required": ["router", "recovery", "synthesis"], "additionalProperties": {"$ref": "#/$defs/model"}}]},
    "judge_models": {"type": "object", "required": ["answer_relevancy", "correctness", "hallucination", "prompt_injection", "action_claim"], "additionalProperties": {"$ref": "#/$defs/model"}},
    "datasets": {"type": "object", "required": ["functional", "safety"], "additionalProperties": {"type": "object", "required": ["full", "selected", "schema_version"], "properties": {"schema_version": {"const": 1}, "full": {"oneOf": [{"const": "UNKNOWN"}, {"$ref": "#/$defs/dataset"}]}, "selected": {"$ref": "#/$defs/dataset"}}}},
    "scenario_count": {"type": "integer", "minimum": 0},
    "planned_execution_count": {"type": "integer", "minimum": 0},
    "scenario_set_fingerprint": {"$ref": "#/$defs/digest"},
    "execution_order_fingerprint": {"$ref": "#/$defs/digest"},
    "fingerprints": {"type": "object", "required": ["prompt_bundle", "evaluator_prompts", "tool_contract", "runtime_policy", "safety_policy", "evaluation_config", "release_gates", "slo_spec", "business_fixtures"], "additionalProperties": {"$ref": "#/$defs/identity"}},
    "libraries": {"type": "object", "additionalProperties": {"type": "string"}},
    "hosting": {"type": "object", "required": ["mode", "max_workers", "queue_capacity", "configuration_fingerprint"], "properties": {"mode": {"enum": ["sequential", "bounded", "UNKNOWN"]}, "max_workers": {"type": ["integer", "string"]}, "queue_capacity": {"type": ["integer", "string"]}, "configuration_fingerprint": {"$ref": "#/$defs/digest"}}},
    "lineage_status": {"enum": ["FULL_LINEAGE", "PARTIAL_LINEAGE", "LEGACY_UNVERSIONED"]},
    "unavailable_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"oneOf": [{"const": "UNKNOWN"}, {"$ref": "#/$defs/digest"}]},
    "model": {"type": "object", "required": ["resolved", "provider", "resolution_provenance"], "additionalProperties": {"type": "string"}},
    "dataset": {"type": "object", "required": ["schema_version", "count", "fingerprint"], "additionalProperties": false, "properties": {"schema_version": {"const": 1}, "count": {"type": "integer", "minimum": 0}, "fingerprint": {"$ref": "#/$defs/digest"}}}
  }
}
